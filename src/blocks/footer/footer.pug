footer.footer.light-block#footer
    .footer__container.container
        form.footer__form.form
            h2.footer__form-title.title-section.decor-line.decor-line--dark Напишите мне
            p.footer__form-subtitle Оставьте свои контакты в этой форме, и я обязательно с вами свяжусь.
            .footer__form-body
                input.input--light(placeholder="Ваше имя" name="name" minlength="3" autocomplete="off" required)
                input.input--light(placeholder="Телефон" name="phone" inputmode="tel" data-tel-input minlength="15" autocomplete="off" required)
                textarea.input--light(rows="4" name="message" placeholder="Сообщение")

                label.footer__form-checkbox
                    input(type="checkbox" name="success" required)
                    span Даю согласие на обработку персональных данных

                button(type="submit") Отправить

        .footer__contacts
            img.footer__contacts-img(src="./assets/img/ava-feedback.png")
            h3.footer__contacts-title.font-decor Либо свяжитесь со мной по почте или WhatsApp
            ul.footer__contacts-list
                li.footer__contacts-item.decor-line.decor-line--dark
                    span Телефон & whatsapp
                    a.footer__contacts-item-tel(href="tel:+79366660016") 8 936 666 00 16
                li.footer__contacts-item
                    span Эл. почта
                    a.footer__contacts-item-email(href="mailto:kseniabarke@gmail.com" title="почта") kseniabarke@gmail.com

            .footer__contacts-social
                a.footer__contacts-social-item(href="https://wa.me/79366660016" title="WhatsApp" target="_blank")
                    img(src="./assets/img/icons/wa.svg")
                a.footer__contacts-social-item(href="https://t.me/kseniabarke" title="Telegram" target="_blank")
                    img(src="./assets/img/icons/telegram.svg")
                a.footer__contacts-social-item(href="mailto:kseniabarke@gmail.com" title="Email" target="_blank")
                    img(src="./assets/img/icons/email.svg")

        .footer__bottom
            span.footer__author.font-decor Барке Ксения Андреевна
            span.footer__inn ИНН 246316523369
            a.footer__email(href="mailto: kseniabarke@gmail.com") kseniabarke@gmail.com
            a.footer__tel(href="tel:89366660016") 8 936 666 00 16
            span.footer__profession Психотерапевт, клинический психолог
            br
            a.footer__docs(href="./assets/files/offer-robokassa.pdf" target="_blank") Оферта
            a.footer__docs(href="./assets/files/policy.pdf" target="_blank") Политика обработки персональных данных
            a.footer__docs(href="./assets/files/personal-data.pdf" target="_blank") Политика конфиденциальности

            span.footer__copyright © 2026


